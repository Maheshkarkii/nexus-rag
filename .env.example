# ==============================================================================
# AI Research Assistant — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# IMPORTANT:
# - Do NOT commit real secrets, production credentials, or API keys to git.
# - All default values in this template are configured for local Docker development.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application General Settings
# ------------------------------------------------------------------------------
APP_NAME="AI Research Assistant"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Backend Service Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# JSON-encoded array or comma-separated list of allowed CORS origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# ------------------------------------------------------------------------------
# Frontend Service Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
# Browser-accessible backend API URL for client-side fetches
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_research_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
# Internal connection string for backend container
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_password@postgres:5432/ai_research_db

# ------------------------------------------------------------------------------
# Storage & Document Ingestion Configuration (Stage 8)
# ------------------------------------------------------------------------------
STORAGE_PATH=storage
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# Qdrant Vector Store Configuration
# ------------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# Internal URL used by the backend container to connect to Qdrant
QDRANT_URL=http://qdrant:6333
# Qdrant API key (optional for local development, required in production/cloud)
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# Future Stage Placeholders (Not active in Stage 1)
# ------------------------------------------------------------------------------
# Redis Cache & Background Queue (Future stages)
REDIS_URL=redis://redis:6379/0

# LLM Provider Configuration (Future RAG & Agent stages)
# Supported providers: groq, openai, anthropic, ollama
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Embedding Model (Future embedding stage)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
